# Postgres connection string. On Render this is injected from the database
# resource defined in render.yaml.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional — Render sets PORT for you.
# PORT=3000
# HOST=0.0.0.0

# Force TLS for managed Postgres that needs it (auto-detected from sslmode=require).
# DATABASE_SSL=true
